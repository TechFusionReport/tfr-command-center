OUTPUT_FILE=/var/www/status/status.json
N8N_URL=https://n8n.techfusionreport.com
N8N_API_KEY=your_n8n_api_key
CF_ACCOUNT_ID=your_cf_account_id
CF_API_TOKEN=your_cf_api_token
NOTION_TOKEN=your_notion_integration_token
NOTION_CONTENT_CATALOG_ID=your_db_id
NOTION_TOPIC_QUEUE_ID=your_db_id
# Must be the "⚡ TFR Task Tracker" data source id specifically (not Life Task Tracker) —
# the Command Center is TFR-scoped, same as GITHUB_* below.
NOTION_TASK_TRACKER_ID=your_db_id
# Read-only PAT (classic or fine-grained with pull-requests:read) for Website + Automations.
# Required for GitHub PR tracking — without it that section just reports no PRs.
# 2 repos polled every 60s (~2,880 req/day) is well within an authenticated PAT's 5,000/hr limit,
# but would blow through GitHub's unauthenticated ~60/hr limit.
GITHUB_TOKEN=your_github_pat
GITHUB_ORG=TechFusionReport
TIMEOUT_S=5
